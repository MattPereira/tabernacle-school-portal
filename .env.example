# Neon Postgres connection string — consumed by src/lib/db and drizzle.config.ts
DATABASE_URL=

# FACTS SIS API (read-only source of the mirror)
FACTS_API_KEY=
FACTS_SUBSCRIPTION_KEY=

# better-auth. BETTER_AUTH_URL is the app's own origin (http://localhost:3000 in dev).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google OAuth client (Workspace-restricted; sign-in sends hd=tbs.org).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev-only: resolve access as this user without real OAuth
ADMIN_IMPERSONATE_EMAIL=
